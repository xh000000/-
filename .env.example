# 模型接入通道：openai（任意 OpenAI 兼容接口）或 codebuddy-cli（本机 CodeBuddy 命令行）
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# 单次调用超时（秒）；codebuddy-cli 通道默认 240
# AI_TIMEOUT=180
# 单次输出上限（token）。推理模型的思考 token 与正文共用此额度：
# deepseek-v4-pro 实测单章思考约 3000，留 8000 才稳定出正文
# AI_MAX_TOKENS=8000

# 管理员也可在「基本配置 → 外部模型」里改模型/接口地址/密钥（存 app_settings，优先于这里）
# 走 codebuddy-cli 时，把 CodeBuddy 的密钥填进 AI_API_KEY（服务端读取，不下发前端）
# CODEBUDDY_CLI=codebuddy
# 中国版账号必须带 internal，否则会连到海外端点导致鉴权失败；海外版留空
# CODEBUDDY_INTERNET_ENVIRONMENT=internal
# 追加给 CLI 的参数，空格分隔
# CODEBUDDY_CLI_ARGS=

# ---------------------------------------------------------------------------
# Agent 服务层（/api/agent/*，LangGraph 智能体）
# 每项独立生效：未配置的项回落到上面的平台外部模型（AI_* / 页面配置），
# 全都没配时 Agent 不可用（状态页会说明出处），平台其余功能不受影响。
# ---------------------------------------------------------------------------
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=
# AGENT_MODEL=
# 单次输出上限（token），推理模型注意思考 token 与正文共用额度
# AGENT_MAX_TOKENS=8000
# 采样温度（默认 0.3）
# AGENT_TEMPERATURE=0.3
# 单次模型调用超时秒数（默认 180）
# AGENT_TIMEOUT=180
# 单轮对话最多工具调用循环数（默认 40）
# AGENT_RECURSION_LIMIT=40

# AI 日报流水线定时触发（UTC HH:MM，如 23:30 ≈ 北京时间早上 7:30）。
# 留空（默认）不启用定时，只在「AI 问答」页手动触发。每天最多自动跑一次。
# AGENT_PIPELINE_TIME=

# Enable when serving behind an HTTPS reverse proxy
COOKIE_SECURE=0
